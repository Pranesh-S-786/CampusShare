# ========================================================
# CampusShare Backend Environment Template (Supabase PostgreSQL)
# ========================================================
# Copy this file to .env and paste your Supabase connection strings.
# NEVER commit real credentials, database passwords, or secret keys to Git.

# Django Core Security & Runtime
DJANGO_SECRET_KEY=replace_with_a_long_random_secret_key_in_production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.campusshare.edu,your-app.onrender.com

# ========================================================
# Supabase PostgreSQL Connection Strings
# ========================================================

# 1. Primary Pooled Connection URL (Port 6543 - Transaction Mode)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. Direct Connection URL (Port 5432 - Direct Mode for migrations if needed)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Pooler Performance Settings
DB_DISABLE_SERVER_SIDE_CURSORS=True
DB_CONN_MAX_AGE=600

# ========================================================
# CORS & CSRF Configuration (Allowed Frontend Origins)
# ========================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://campusshare.edu,https://your-frontend.pages.dev
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://campusshare.edu,https://your-frontend.pages.dev

# ========================================================
# Production SSL & Cookie Security
# ========================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_PROXY_SSL_HEADER=True

# ========================================================
# Supabase Storage Configuration (Profile Photos & Item Images)
# ========================================================
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Backend service-role secret key (never expose to frontend clients)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_STORAGE_BUCKET_LISTINGS=listings

# ========================================================
# Email Delivery Configuration (OTP Verification & Password Reset)
# ========================================================
# In development (DJANGO_DEBUG=True), OTP codes are output to server console if SMTP is unconfigured.
# For production SMTP delivery, configure your provider (e.g., SendGrid, Mailgun, Amazon SES, Gmail):
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CampusShare <noreply@campusshare.edu>
